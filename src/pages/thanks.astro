---
import Layout from '../layouts/Layout.astro';
import logo from '../assets/DAYTIMERS_NEW_YORK_2025.png';

const instagramUrl = 'https://www.instagram.com/daytimers_nyc/';
---

<Layout>
	<main class="thanks-page">
		<section class="thanks-dialog" aria-labelledby="thanks-title">
			<p class="eyebrow">Subcontinental Studios</p>
			<h1 id="thanks-title">Thanks<br /><em>for applying!</em></h1>
			<p class="message">
				Thanks for applying! We will get back to you shortly. In the meantime, if you have any questions, you can email us at{' '}
				<a href="mailto:nyc@daytimers.org">nyc@daytimers.org</a> or DM on Instagram{' '}
				<a href={instagramUrl} target="_blank" rel="noreferrer">@daytimers_nyc</a>
			</p>
			<a
				class="logo-link"
				href={instagramUrl}
				target="_blank"
				rel="noreferrer"
				aria-label="Visit Daytimers New York on Instagram"
			>
				<img class="logo" src={logo.src} alt="Daytimers New York" />
			</a>
		</section>
	</main>
</Layout>

<style>
	.thanks-page {
		display: grid;
		place-items: center;
		min-height: 100vh;
		padding: clamp(1.5rem, 5vw, 4rem);
		background: linear-gradient(135deg, var(--maroon-wash), transparent 38%), var(--sand);
	}

	.thanks-dialog {
		width: min(100%, 44rem);
		padding: clamp(2rem, 6vw, 5rem);
		border: 1px solid var(--sand-line);
		background: var(--cream-wash);
		box-shadow: var(--poster-shadow);
	}

	.logo-link {
		display: flex;
		justify-content: center;
		width: 100%;
		margin: 2rem auto 0;
	}

	.logo-link:focus-visible {
		outline: 3px solid var(--magenta);
		outline-offset: 3px;
	}

	.logo {
		display: block;
		width: min(100%, 15rem);
		height: auto;
		mix-blend-mode: multiply;
		transition: opacity 160ms ease;
	}

	.logo-link:hover .logo {
		opacity: 0.78;
	}

	.eyebrow {
		margin: 0 0 1rem;
		color: var(--maroon);
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		color: var(--maroon);
		font-family: var(--display-font);
		font-size: clamp(3rem, 9vw, 5.5rem);
		line-height: 0.9;
		text-transform: uppercase;
	}

	h1 em {
		color: var(--magenta);
		font-style: normal;
	}

	.message {
		max-width: 34rem;
		margin: 1.8rem 0 2.2rem;
		font-size: clamp(1.05rem, 1.6vw, 1.25rem);
		line-height: 1.55;
	}

	.message a {
		color: var(--maroon);
		font-weight: 800;
		text-underline-offset: 0.2em;
	}

	@media (max-width: 600px) {
		.thanks-page {
			place-items: start center;
			padding: 2rem 1.25rem;
		}

		.thanks-dialog {
			padding: 2rem 1.35rem;
		}
	}
</style>
