---
import '../styles/tokens.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/daytimers_favicon.png" />
		<meta
			name="description"
			content="Daytimers NYC is a collective of South Asian producers, songwriters, and artists based in the New York City area. We host collaboration sessions, workshops, and events to connect and support the community."
		/>
		<meta name="theme-color" content="#e4d3bc" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content="Daytimers NYC" />
		<meta
			property="og:description"
			content="Daytimers NYC is a collective of South Asian producers, songwriters, and artists based in the New York City area. We host collaboration sessions, workshops, and events to connect and support the community."
		/>
		<meta property="og:image" content="/DAYTIMERS_NYC_WHITE_BG.png" />
		<meta property="og:image:alt" content="Daytimers New York" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Daytimers NYC" />
		<meta
			name="twitter:description"
			content="Daytimers NYC is a collective of South Asian producers, songwriters, and artists based in the New York City area. We host collaboration sessions, workshops, and events to connect and support the community."
		/>
		<meta name="twitter:image" content="/DAYTIMERS_NYC_WHITE_BG.png" />
		<meta name="twitter:image:alt" content="Daytimers New York" />
		<meta name="generator" content={Astro.generator} />
		<title>Daytimers NYC</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		scroll-behavior: smooth;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	body {
		background: var(--sand);
		color: var(--charcoal);
		font-family: var(--body-font);
	}
</style>
