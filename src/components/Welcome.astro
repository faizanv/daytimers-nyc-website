---
import { Image } from 'astro:assets';
import poster from '../assets/subcontinental_studios.jpeg';
---

<main class="landing-page">
	<section class="poster-panel" aria-label="Subcontinental Studios event poster">
		<div class="poster-frame">
			<Image
				src={poster}
				alt="Daytimers NYC Subcontinental Studios event poster"
				class="poster"
				widths={[480, 640, 768, 1080]}
				sizes="(max-width: 760px) 100vw, 50vw"
				format="webp"
				decoding="async"
			/>
		</div>
	</section>

	<section class="content-panel" id="overview">
		<div class="content-inner">
			<header class="hero-copy">
				<p class="eyebrow">Daytimers New York presents</p>
				<h1><span class="beat">Subcontinental</span><br /><em><span class="beat">Studios</span></em></h1>
				<p class="intro">
					A collaboration session for South Asian producers, songwriters, and artists with 3+ years of music-making experience in the New York City area. We especially welcome femme, trans, and non-binary creators, and everyone is encouraged to apply.
				</p>
			</header>

			<div class="event-details" aria-label="Event details">
				<div>
					<span class="detail-label">When</span>
					<strong>November 7, 2026</strong>
				</div>
				<div>
					<span class="detail-label">Where</span>
					<strong>
						<a class="location-link" href="https://maps.app.goo.gl/UMykVFChh5cRXe3G7" target="_blank" rel="noreferrer">
							Hyperballad Studios<br />293 Meserole St, Brooklyn
						</a>
					</strong>
				</div>
				<div>
					<span class="detail-label">Apply by</span>
					<strong>October 9, 2026</strong>
				</div>
			</div>

			<section class="application-block" id="application">
				<p class="section-kicker">Applications open now</p>
				<h2>Bring your sound<br />to the room.</h2>
				<p>
					Come ready to make, share, and build with a room full of South Asian talent. Selected demos will be reviewed by a panel and may be considered for release through a label, a Bandcamp compilation, or another community project.
				</p>
				<a class="apply-button" href="/apply">Apply Now <span aria-hidden="true">↗</span></a>
			</section>

			<section class="faq" id="faq">
				<p class="section-kicker">Good to know</p>
				<details open>
					<summary>Who is this for?</summary>
					<p>
						South Asian producers, songwriters, vocalists, and artists in the New York City area. We are centering femme, trans, and non-binary creators while welcoming applications from everyone in the community.
					</p>
				</details>
				<details>
					<summary>What happens in the session?</summary>
					<p>
						A focused collaboration day for writing, producing, and connecting with artists across the community. Selected demos will be reviewed by a panel for potential release opportunities.
					</p>
				</details>
				<details>
					<summary>Where is it?</summary>
					<p>
						<a class="location-link" href="https://maps.app.goo.gl/UMykVFChh5cRXe3G7" target="_blank" rel="noreferrer">Hyperballad Studios</a>
						{' '}at 293 Meserole Street in Brooklyn, New York.
					</p>
				</details>
			</section>
		</div>
	</section>

	<nav class="mobile-nav" aria-label="Page navigation">
		<a class="nav-apply" href="/apply">Apply Now <span aria-hidden="true">↗</span></a>
	</nav>
</main>

<style>
	.landing-page {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		min-height: 100vh;
		background: linear-gradient(135deg, var(--maroon-wash), transparent 38%), var(--sand);
	}

	.poster-panel {
		position: sticky;
		top: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		height: 100vh;
		padding: clamp(0.75rem, 2vw, 1.5rem);
		background: var(--sand);
	}

	.poster-frame {
		display: flex;
		align-items: center;
		justify-content: center;
		width: fit-content;
		max-width: 100%;
		height: auto;
		padding: clamp(0.75rem, 2vw, 1.5rem);
		border: 1px solid var(--sand-line);
		border-radius: 0.35rem;
		background: var(--sand);
	}

	.poster {
		display: block;
		width: auto;
		max-width: 100%;
		height: auto;
		aspect-ratio: 3 / 4;
		max-height: calc(100vh - 6rem);
		object-fit: contain;
		border-radius: 0.12rem;
		box-shadow: var(--poster-shadow);
	}

	.content-panel {
		display: flex;
		align-items: center;
		min-height: 100vh;
		padding: clamp(3rem, 7vw, 7rem) clamp(2rem, 7vw, 7rem);
	}

	.content-inner {
		width: min(100%, 38rem);
	}

	.hero-copy {
		padding-bottom: clamp(2rem, 5vw, 4rem);
		border-bottom: 1px solid var(--muted-line);
	}

	.eyebrow,
	.section-kicker,
	.detail-label {
		margin: 0 0 1rem;
		color: var(--maroon);
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.16em;
		line-height: 1.2;
		text-transform: uppercase;
	}

	h1,
	h2 {
		margin: 0;
		font-family: var(--display-font);
		font-weight: 900;
		letter-spacing: 0.015em;
		line-height: 0.9;
		text-transform: uppercase;
	}

	h1 {
		color: var(--maroon);
		max-width: 100%;
		font-size: clamp(2.75rem, 5vw, 4.5rem);
		overflow-wrap: anywhere;
	}

	h1 em {
		color: var(--magenta);
		font-style: normal;
	}

	.beat {
		--bpm: 60;
		display: inline-block;
		transform-origin: center;
		animation: beat calc(60s / var(--bpm)) cubic-bezier(0.2, 0.9, 0.3, 1) infinite;
		animation-iteration-count: infinite;
	}

	@keyframes beat {
		0% {
			transform: scale(1);
		}

		5% {
			transform: scale(1.08);
		}

		16% {
			transform: scale(1.01);
		}

		24% {
			transform: scale(1.06);
		}

        45%,
		100% {
			transform: scale(1);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.beat {
			animation: none;
		}
	}

	.intro {
		max-width: 30rem;
		margin: 1.8rem 0 0;
		font-size: clamp(1.05rem, 1.6vw, 1.3rem);
		font-weight: 600;
		line-height: 1.45;
	}

	.event-details {
		display: grid;
		grid-template-columns: 1fr 1.3fr;
		gap: 2rem;
		padding: 1.6rem 0;
		border-bottom: 1px solid var(--muted-line);
	}

	.detail-label {
		display: block;
		margin-bottom: 0.45rem;
		color: var(--charcoal);
		opacity: 0.62;
	}

	.event-details strong {
		font-size: 0.95rem;
		line-height: 1.35;
	}

	.location-link {
		color: var(--maroon);
		text-underline-offset: 0.2em;
	}

	.application-block {
		padding: clamp(2.2rem, 5vw, 4rem) 0;
	}

	.application-block h2 {
		color: var(--maroon);
		font-size: clamp(2.75rem, 5vw, 4.5rem);
	}

	.application-block > p:not(.section-kicker) {
		max-width: 31rem;
		margin: 1.2rem 0 1.8rem;
		font-size: 1rem;
		line-height: 1.6;
	}

	.apply-button,
	.nav-apply {
		display: inline-flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		min-width: 10.5rem;
		padding: 0.9rem 1.1rem;
		border: 2px solid var(--magenta);
		background: var(--magenta);
		color: var(--cream);
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		text-decoration: none;
		text-transform: uppercase;
		transition: transform 160ms ease, background 160ms ease, color 160ms ease;
	}

	.apply-button:hover,
	.apply-button:focus-visible,
	.nav-apply:hover,
	.nav-apply:focus-visible {
		transform: translate(-0.2rem, -0.2rem);
		background: var(--maroon);
		border-color: var(--maroon);
	}

	.faq {
		padding-bottom: 2rem;
	}

	.faq details {
		border-top: 1px solid var(--muted-line);
	}

	.faq details:last-child {
		border-bottom: 1px solid var(--muted-line);
	}

	.faq summary {
		cursor: pointer;
		list-style: none;
		padding: 1.1rem 0;
		font-size: 0.95rem;
		font-weight: 800;
	}

	.faq summary::-webkit-details-marker {
		display: none;
	}

	.faq summary::after {
		float: right;
		color: var(--magenta);
		content: '+';
		font-size: 1.3rem;
		font-weight: 400;
	}

	.faq details[open] summary::after {
		content: '-';
	}

	.faq details p {
		max-width: 32rem;
		margin: -0.25rem 2rem 1.2rem 0;
		font-size: 0.9rem;
		line-height: 1.55;
	}

	.mobile-nav {
		display: none;
	}

	@media (max-width: 760px) {
		.landing-page {
			display: block;
			padding-bottom: 4.7rem;
		}

		.poster-panel {
			position: relative;
			height: auto;
			min-height: 0;
			padding: 0.75rem 0.75rem 0.25rem;
		}

		.poster-frame {
			width: 100%;
			height: auto;
			padding: 0;
		}

		.poster {
			width: 100%;
			max-height: none;
		}

		.content-panel {
			min-height: 0;
			padding: 0.75rem 1.35rem 1rem;
		}

		.content-inner {
			width: 100%;
		}

		h1 {
			font-size: clamp(2.5rem, 12vw, 4rem);
		}

		.event-details {
			grid-template-columns: 1fr;
			gap: 1.2rem;
		}

		.apply-button {
			width: 100%;
		}

		.mobile-nav {
			position: fixed;
			z-index: 2;
			right: 0;
			bottom: 0;
			left: 0;
			display: flex;
			align-items: center;
			min-height: 4rem;
			padding: 0.55rem 0.75rem 0.55rem 1.1rem;
			border-top: 1px solid var(--sand-muted);
			background: var(--charcoal);
		}

		.mobile-nav a {
			color: var(--sand);
			font-size: 0.68rem;
			font-weight: 800;
			letter-spacing: 0.1em;
			text-decoration: none;
			text-transform: uppercase;
		}

		.mobile-nav .nav-apply {
			min-width: 0;
			padding: 0.75rem 0.85rem;
			font-size: 0.68rem;
		}
	}
</style>