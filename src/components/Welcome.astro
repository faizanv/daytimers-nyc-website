---
import logo from '../assets/DAYTIMERS_NEW_YORK_2025.png';
---

<div class="landing-page">
	<div class="logo-wrap">
		<img src={logo.src} alt="Daytimers NYC 2025" class="logo" />
	</div>
	<p class="message">Coming soon</p>
</div>

<style>
	:global(body) {
		margin: 0;
		background: #ffffff;
		font-family: Arial, Helvetica, sans-serif;
	}

	.landing-page {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		height: 100vh;
		background: #ffffff;
		text-align: center;
	}

	.logo-wrap {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0 24px;
	}

	.logo {
		display: block;
		max-width: min(80vw, 700px);
		height: auto;
	}

	.message {
		margin: 1.5rem 0 0;
		font-size: clamp(1.1rem, 2vw, 1.6rem);
		letter-spacing: 0.08em;
		text-transform: none;
		color: #111111;
</style>
